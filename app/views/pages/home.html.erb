<!DOCTYPE html>
<html class="scroll-smooth">
<head>
  <title>BadmintonPH - Book Badminton Courts Across the Philippines</title>
  <meta name="description" content="Find and book badminton courts across the Philippines. Instant booking, best prices, premium facilities.">
</head>
<body class="bg-white">
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-blue-600 via-blue-700 to-blue-900 text-white overflow-hidden">
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-0 left-0 w-96 h-96 bg-white rounded-full -translate-x-1/2 -translate-y-1/2"></div>
      <div class="absolute bottom-0 right-0 w-96 h-96 bg-white rounded-full translate-x-1/2 translate-y-1/2"></div>
    </div>

    <nav class="relative z-10 container mx-auto px-4 py-6">
      <div class="flex justify-between items-center">
        <div class="flex items-center space-x-2">
          <span class="text-4xl">🏸</span>
          <span class="text-2xl font-bold">BadmintonPH</span>
        </div>
        <div class="hidden md:flex items-center space-x-6">
          <a href="#how-it-works" class="hover:text-blue-200 transition">How it Works</a>
          <a href="#cities" class="hover:text-blue-200 transition">Cities</a>
          <a href="#features" class="hover:text-blue-200 transition">Features</a>
          <% if user_signed_in? %>
            <%= link_to "My Bookings", bookings_path, class: "hover:text-blue-200 transition" %>
            <%= link_to "Account", edit_user_registration_path, class: "hover:text-blue-200 transition" %>
          <% else %>
            <%= link_to "Sign In", new_user_session_path, class: "hover:text-blue-200 transition" %>
            <%= link_to "Sign Up", new_user_registration_path, class: "bg-white text-blue-600 px-6 py-2 rounded-full font-semibold hover:bg-blue-50 transition" %>
          <% end %>
        </div>
      </div>
    </nav>

    <div class="relative z-10 container mx-auto px-4 py-20">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-5xl md:text-7xl font-bold mb-6 leading-tight">
          Find & Book<br>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-yellow-200 to-yellow-400">
            Badminton Courts
          </span><br>
          Near You
        </h1>
        <p class="text-xl md:text-2xl text-blue-100 mb-12 max-w-2xl mx-auto">
          Book premium badminton courts across the Philippines in just a few clicks. 
          Instant confirmation, best prices, no hassle.
        </p>

        <!-- Search Bar -->
        <%= form_with url: search_path, method: :get, class: "max-w-4xl mx-auto" do |f| %>
          <div class="bg-white rounded-2xl shadow-2xl p-3 md:p-4">
            <div class="grid md:grid-cols-12 gap-3">
              <!-- Location -->
              <div class="md:col-span-4">
                <div class="relative">
                  <span class="absolute left-4 top-1/2 -translate-y-1/2 text-2xl">📍</span>
                  <%= f.text_field :query, 
                                  placeholder: "City, venue, or location...",
                                  class: "w-full pl-14 pr-4 py-4 rounded-xl border-2 border-transparent focus:border-blue-500 focus:outline-none text-gray-800 font-medium",
                                  value: params[:query] %>
                </div>
              </div>

              <!-- Date -->
              <div class="md:col-span-3">
                <div class="relative">
                  <span class="absolute left-4 top-1/2 -translate-y-1/2 text-2xl">📅</span>
                  <%= f.date_field :date, 
                                  value: Date.current,
                                  min: Date.current,
                                  class: "w-full pl-14 pr-4 py-4 rounded-xl border-2 border-transparent focus:border-blue-500 focus:outline-none text-gray-800 font-medium" %>
                </div>
              </div>

              <!-- Time -->
              <div class="md:col-span-3">
                <div class="relative">
                  <span class="absolute left-4 top-1/2 -translate-y-1/2 text-2xl">⏰</span>
                  <%= f.select :time,
                              options_for_select([['Any Time', '']] + (6..22).map { |h| ["#{h}:00", h] }, params[:time]),
                              {},
                              class: "w-full pl-14 pr-4 py-4 rounded-xl border-2 border-transparent focus:border-blue-500 focus:outline-none text-gray-800 font-medium appearance-none" %>
                </div>
              </div>

              <!-- Search Button -->
              <div class="md:col-span-2">
                <%= f.submit "Search", class: "w-full bg-gradient-to-r from-blue-600 to-blue-700 text-white py-4 rounded-xl font-bold hover:from-blue-700 hover:to-blue-800 transition cursor-pointer shadow-lg" %>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Quick Stats -->
        <div class="mt-12 grid grid-cols-3 gap-8 max-w-2xl mx-auto">
          <div>
            <div class="text-4xl font-bold text-yellow-300"><%= @total_venues %>+</div>
            <div class="text-blue-200 mt-1">Venues</div>
          </div>
          <div>
            <div class="text-4xl font-bold text-yellow-300"><%= @total_courts %>+</div>
            <div class="text-blue-200 mt-1">Courts</div>
          </div>
          <div>
            <div class="text-4xl font-bold text-yellow-300"><%= @upcoming_schedules %>+</div>
            <div class="text-blue-200 mt-1">Available Slots</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Wave Shape -->
    <div class="absolute bottom-0 left-0 w-full">
      <svg viewBox="0 0 1440 120" class="w-full h-auto">
        <path fill="#ffffff" d="M0,64L80,69.3C160,75,320,85,480,80C640,75,800,53,960,48C1120,43,1280,53,1360,58.7L1440,64L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z"></path>
      </svg>
    </div>
  </section>

  <!-- Featured Cities -->
  <section id="cities" class="py-20 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          Book Courts Across the Philippines
        </h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Find premium badminton facilities in major cities nationwide
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
        <% @featured_cities.each do |city| %>
          <%= link_to search_path(province: city[:name]), class: "group" do %>
            <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
              <div class="bg-gradient-to-br from-blue-500 to-blue-700 p-8 text-center">
                <div class="text-6xl mb-3"><%= city[:image] %></div>
                <h3 class="text-2xl font-bold text-white"><%= city[:name] %></h3>
              </div>
              <div class="p-6 text-center">
                <div class="text-3xl font-bold text-blue-600"><%= city[:count] %></div>
                <div class="text-gray-600 mt-1">Venues Available</div>
                <div class="mt-4 text-blue-600 font-semibold group-hover:text-blue-800">
                  Explore Courts →
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section id="how-it-works" class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          Book in 3 Simple Steps
        </h2>
        <p class="text-xl text-gray-600">
          Quick, easy, and hassle-free booking process
        </p>
      </div>

      <div class="max-w-5xl mx-auto">
        <div class="grid md:grid-cols-3 gap-8">
          <!-- Step 1 -->
          <div class="text-center group">
            <div class="relative mb-6">
              <div class="w-24 h-24 bg-gradient-to-br from-blue-500 to-blue-600 rounded-full mx-auto flex items-center justify-center text-white text-4xl font-bold shadow-xl group-hover:scale-110 transition-transform">
                1
              </div>
              <div class="absolute top-0 left-1/2 w-full h-full bg-blue-100 rounded-full -translate-x-1/2 -z-10 scale-150 opacity-0 group-hover:opacity-100 transition-opacity"></div>
            </div>
            <div class="text-5xl mb-4">🔍</div>
            <h3 class="text-2xl font-bold text-gray-900 mb-3">Search Courts</h3>
            <p class="text-gray-600">
              Find available courts in your area by location, date, and time
            </p>
          </div>

          <!-- Step 2 -->
          <div class="text-center group">
            <div class="relative mb-6">
              <div class="w-24 h-24 bg-gradient-to-br from-blue-600 to-blue-700 rounded-full mx-auto flex items-center justify-center text-white text-4xl font-bold shadow-xl group-hover:scale-110 transition-transform">
                2
              </div>
              <div class="absolute top-0 left-1/2 w-full h-full bg-blue-100 rounded-full -translate-x-1/2 -z-10 scale-150 opacity-0 group-hover:opacity-100 transition-opacity"></div>
            </div>
            <div class="text-5xl mb-4">📅</div>
            <h3 class="text-2xl font-bold text-gray-900 mb-3">Select & Book</h3>
            <p class="text-gray-600">
              Choose your preferred time slot and complete your booking
            </p>
          </div>

          <!-- Step 3 -->
          <div class="text-center group">
            <div class="relative mb-6">
              <div class="w-24 h-24 bg-gradient-to-br from-blue-700 to-blue-800 rounded-full mx-auto flex items-center justify-center text-white text-4xl font-bold shadow-xl group-hover:scale-110 transition-transform">
                3
              </div>
              <div class="absolute top-0 left-1/2 w-full h-full bg-blue-100 rounded-full -translate-x-1/2 -z-10 scale-150 opacity-0 group-hover:opacity-100 transition-opacity"></div>
            </div>
            <div class="text-5xl mb-4">🏸</div>
            <h3 class="text-2xl font-bold text-gray-900 mb-3">Play & Enjoy</h3>
            <p class="text-gray-600">
              Show up and play! Your court is ready and waiting
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="py-20 bg-gradient-to-br from-gray-50 to-blue-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          Why Choose BadmintonPH?
        </h2>
        <p class="text-xl text-gray-600">
          The best way to book badminton courts in the Philippines
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-7xl mx-auto">
        <div class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-shadow">
          <div class="text-5xl mb-4">⚡</div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Instant Booking</h3>
          <p class="text-gray-600">Get immediate confirmation for your court reservation</p>
        </div>

        <div class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-shadow">
          <div class="text-5xl mb-4">💰</div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Best Prices</h3>
          <p class="text-gray-600">Competitive rates and transparent pricing with no hidden fees</p>
        </div>

        <div class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-shadow">
          <div class="text-5xl mb-4">🔒</div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Secure Payment</h3>
          <p class="text-gray-600">Multiple payment options with secure transaction processing</p>
        </div>

        <div class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-shadow">
          <div class="text-5xl mb-4">📱</div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Mobile Friendly</h3>
          <p class="text-gray-600">Book on-the-go with our mobile-optimized platform</p>
        </div>

        <div class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-shadow">
          <div class="text-5xl mb-4">🏆</div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Premium Facilities</h3>
          <p class="text-gray-600">Access to top-quality courts with modern amenities</p>
        </div>

        <div class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-shadow">
          <div class="text-5xl mb-4">📍</div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Wide Coverage</h3>
          <p class="text-gray-600">Find courts across major cities in the Philippines</p>
        </div>

        <div class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-shadow">
          <div class="text-5xl mb-4">⭐</div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Loyalty Rewards</h3>
          <p class="text-gray-600">Earn points and get discounts on future bookings</p>
        </div>

        <div class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-shadow">
          <div class="text-5xl mb-4">🔔</div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Smart Reminders</h3>
          <p class="text-gray-600">Never miss your game with automated notifications</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-gradient-to-r from-blue-600 to-blue-800 text-white">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-4xl md:text-5xl font-bold mb-6">
        Ready to Play?
      </h2>
      <p class="text-xl md:text-2xl text-blue-100 mb-10 max-w-2xl mx-auto">
        Join thousands of badminton players who book their courts with BadmintonPH
      </p>
      <%= link_to search_path, class: "inline-block bg-white text-blue-600 px-10 py-5 rounded-full text-xl font-bold hover:bg-blue-50 transition shadow-2xl transform hover:scale-105" do %>
        Find Courts Near You 🏸
      <% end %>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-gray-900 text-gray-300 py-12">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-4 gap-8 mb-8">
        <div>
          <div class="flex items-center space-x-2 mb-4">
            <span class="text-3xl">🏸</span>
            <span class="text-xl font-bold text-white">BadmintonPH</span>
          </div>
          <p class="text-sm">
            The #1 platform for booking badminton courts across the Philippines
          </p>
        </div>
        
        <div>
          <h4 class="text-white font-bold mb-4">Quick Links</h4>
          <ul class="space-y-2 text-sm">
            <li><%= link_to "Search Courts", search_path, class: "hover:text-white" %></li>
            <li><a href="#cities" class="hover:text-white">Cities</a></li>
            <li><a href="#how-it-works" class="hover:text-white">How It Works</a></li>
            <li><%= link_to "My Bookings", bookings_path, class: "hover:text-white" %></li>
          </ul>
        </div>
        
        <div>
          <h4 class="text-white font-bold mb-4">Support</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="#" class="hover:text-white">Help Center</a></li>
            <li><a href="#" class="hover:text-white">Contact Us</a></li>
            <li><a href="#" class="hover:text-white">Terms of Service</a></li>
            <li><a href="#" class="hover:text-white">Privacy Policy</a></li>
          </ul>
        </div>
        
        <div>
          <h4 class="text-white font-bold mb-4">Connect With Us</h4>
          <div class="flex space-x-4">
            <a href="#" class="w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center hover:bg-blue-700">
              <span class="text-xl">f</span>
            </a>
            <a href="#" class="w-10 h-10 bg-blue-400 rounded-full flex items-center justify-center hover:bg-blue-500">
              <span class="text-xl">t</span>
            </a>
            <a href="#" class="w-10 h-10 bg-pink-600 rounded-full flex items-center justify-center hover:bg-pink-700">
              <span class="text-xl">i</span>
            </a>
          </div>
        </div>
      </div>
      
      <div class="border-t border-gray-800 pt-8 text-center text-sm">
        <p>&copy; 2024 BadmintonPH. All rights reserved.</p>
      </div>
    </div>
  </footer>
</body>
</html>
