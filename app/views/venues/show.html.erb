<div class="min-h-screen bg-gray-50">
  <nav class="bg-white shadow-lg mb-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between h-16">
        <div class="flex items-center">
          <%= link_to "← Back to Venues", venues_path, class: "text-blue-600 hover:text-blue-800" %>
        </div>
        <div class="flex items-center space-x-4">
          <% if user_signed_in? %>
            <%= link_to "My Bookings", bookings_path, class: "text-gray-700 hover:text-blue-600" %>
          <% else %>
            <%= link_to "Sign In to Book", new_user_session_path, class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
          <% end %>
        </div>
      </div>
    </div>
  </nav>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Venue Header -->
    <div class="bg-white rounded-lg shadow-md p-6 mb-6">
      <h1 class="text-3xl font-bold mb-4"><%= @venue.name %></h1>
      
      <div class="grid md:grid-cols-2 gap-4 text-gray-600">
        <div>
          <p class="mb-2">
            <span class="font-semibold">Address:</span> <%= @venue.full_address %>
          </p>
          <% if @venue.phone.present? %>
            <p class="mb-2">
              <span class="font-semibold">Phone:</span> <%= @venue.phone %>
            </p>
          <% end %>
        </div>
        <div>
          <p class="mb-2">
            <span class="font-semibold">Total Courts:</span> 
            <%= pluralize(@venue.courts.active.count, 'court') %>
          </p>
        </div>
      </div>
    </div>

    <!-- Court Filters -->
    <div class="bg-white rounded-lg shadow-md p-6 mb-6">
      <h2 class="text-xl font-bold mb-4">Filter Courts</h2>
      
      <%= form_with url: venue_path(@venue), method: :get, class: "grid md:grid-cols-4 gap-4" do |f| %>
        <%= f.hidden_field :date, value: @date %>
        
        <div>
          <%= f.label :court_type, "Court Type", class: "block text-sm font-medium mb-2" %>
          <%= f.select :court_type, 
                      options_for_select(Court::COURT_TYPES.map { |t| [t.titleize, t] }, params[:court_type]), 
                      { include_blank: 'All Types' },
                      class: "w-full px-3 py-2 border rounded-lg" %>
        </div>

        <div>
          <%= f.label :floor_type, "Floor Type", class: "block text-sm font-medium mb-2" %>
          <%= f.select :floor_type, 
                      options_for_select(Court::FLOOR_TYPES.map { |t| [t.titleize, t] }, params[:floor_type]), 
                      { include_blank: 'All Floors' },
                      class: "w-full px-3 py-2 border rounded-lg" %>
        </div>

        <div class="flex items-end">
          <label class="flex items-center">
            <%= f.check_box :aircon, class: "h-4 w-4 text-blue-600 rounded" %>
            <span class="ml-2 text-sm font-medium">Air Conditioned</span>
          </label>
        </div>

        <div class="flex items-end">
          <%= f.submit "Apply", class: "bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700" %>
        </div>
      <% end %>
    </div>

    <!-- Date Selection -->
    <div class="bg-white rounded-lg shadow-md p-6 mb-6">
      <h2 class="text-xl font-bold mb-4">Select Date</h2>
      
      <div class="flex flex-wrap gap-2">
        <% 7.times do |i| %>
          <% date = Date.current + i.days %>
          <%= link_to venue_path(@venue, date: date, court_type: params[:court_type], floor_type: params[:floor_type], aircon: params[:aircon]),
                     class: "px-4 py-2 rounded-lg border #{@date == date ? 'bg-blue-600 text-white border-blue-600' : 'bg-white text-gray-700 border-gray-300 hover:border-blue-600'}" do %>
            <div class="text-center">
              <div class="text-xs"><%= date.strftime('%a') %></div>
              <div class="font-bold"><%= date.strftime('%b %d') %></div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Available Courts and Schedules -->
    <h2 class="text-2xl font-bold mb-4">
      Available Courts for <%#= @date.strftime('%A, %B %d, %Y') %>
    </h2>

    <% if @courts.any? %>
      <div class="space-y-6">
        <% @courts.each do |court| %>
          <div class="bg-white rounded-lg shadow-md p-6">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="text-xl font-bold"><%= court.display_name %></h3>
                <% if court.features_list.present? %>
                  <p class="text-sm text-gray-600 mt-1"><%= court.features_list %></p>
                <% end %>
              </div>
            </div>

            <% available_schedules = court.available_schedules(@date) %>
            <% if available_schedules.any? %>
              <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3">
                <% available_schedules.each do |schedule| %>
                  <%= link_to new_booking_path(schedule_id: schedule.id),
                             class: "border rounded-lg p-3 hover:border-blue-600 hover:shadow-md transition #{schedule.is_peak_hour? ? 'bg-yellow-50' : 'bg-white'}" do %>
                    <div class="text-center">
                      <div class="text-sm font-semibold text-gray-900">
                        <%= schedule.start_time.strftime('%I:%M %p') %>
                      </div>
                      <div class="text-xs text-gray-500">
                        <%= schedule.duration_hours %> hr
                      </div>
                      <div class="text-sm font-bold text-blue-600 mt-1">
                        ₱<%= number_with_delimiter(schedule.price_php, delimiter: ',') %>
                      </div>
                      <% if schedule.is_peak_hour? %>
                        <div class="text-xs text-yellow-600 mt-1">Peak</div>
                      <% end %>
                    </div>
                  <% end %>
                <% end %>
              </div>
            <% else %>
              <p class="text-gray-500 text-center py-4">No available time slots for this date</p>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-white rounded-lg shadow-md p-12 text-center">
        <p class="text-xl text-gray-600">No courts available matching your criteria</p>
      </div>
    <% end %>
  </div>
</div>
