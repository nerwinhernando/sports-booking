<div class="min-h-screen bg-gray-50">
  <nav class="bg-white shadow-lg mb-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between h-16">
        <div class="flex items-center">
          <h1 class="text-2xl font-bold text-blue-600">Find Courts</h1>
        </div>
        <div class="flex items-center space-x-4">
          <%= link_to "Home", main_root_path, class: "text-gray-700 hover:text-blue-600" %>
          <% if user_signed_in? %>
            <%= link_to "My Bookings", bookings_path, class: "text-gray-700 hover:text-blue-600" %>
            <%= link_to current_user.full_name, edit_user_registration_path, class: "text-gray-700 hover:text-blue-600" %>
            <%= link_to "Sign Out", destroy_user_session_path, data: { turbo_method: :delete }, class: "text-gray-700 hover:text-blue-600" %>
          <% else %>
            <%= link_to "Sign In", new_user_session_path, class: "text-gray-700 hover:text-blue-600" %>
            <%= link_to "Sign Up", new_user_registration_path, class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
          <% end %>
        </div>
      </div>
    </div>
  </nav>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Filters -->
    <div class="bg-white rounded-lg shadow-md p-6 mb-6">
      <h2 class="text-xl font-bold mb-4">Filter Courts</h2>
      
      <%= form_with url: venues_path, method: :get, class: "grid md:grid-cols-4 gap-4" do |f| %>
        <div>
          <%= f.label :province, "Province", class: "block text-sm font-medium mb-2" %>
          <%= f.select :province, 
                      options_for_select(@provinces, params[:province]), 
                      { include_blank: 'All Provinces' },
                      class: "w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-600" %>
        </div>

        <div>
          <%= f.label :city, "City/Municipality", class: "block text-sm font-medium mb-2" %>
          <%= f.select :city, 
                      options_for_select(@cities, params[:city]), 
                      { include_blank: 'All Cities' },
                      class: "w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-600" %>
        </div>

        <div>
          <%= f.label :court_type, "Court Type", class: "block text-sm font-medium mb-2" %>
          <%= f.select :court_type, 
                      options_for_select(@court_types.map { |t| [t.titleize, t] }, params[:court_type]), 
                      { include_blank: 'All Types' },
                      class: "w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-600" %>
        </div>

        <div>
          <%= f.label :floor_type, "Floor Type", class: "block text-sm font-medium mb-2" %>
          <%= f.select :floor_type, 
                      options_for_select(@floor_types.map { |t| [t.titleize, t] }, params[:floor_type]), 
                      { include_blank: 'All Floors' },
                      class: "w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-600" %>
        </div>

        <div class="flex items-end">
          <label class="flex items-center">
            <%= f.check_box :aircon, class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" %>
            <span class="ml-2 text-sm font-medium">Air Conditioned Only</span>
          </label>
        </div>

        <div class="flex items-end space-x-2">
          <%= f.submit "Apply Filters", class: "bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700" %>
          <%= link_to "Clear", venues_path, class: "bg-gray-300 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-400" %>
        </div>
      <% end %>
    </div>

    <!-- Results -->
    <div class="mb-4 flex justify-between items-center">
      <h2 class="text-2xl font-bold">Available Venues</h2>
      <p class="text-gray-600"><%= @venues.total_count %> venues found</p>
    </div>

    <% if @venues.any? %>
      <div class="grid md:grid-cols-3 gap-6">
        <% @venues.each do |venue| %>
          <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition">
            <div class="p-6">
              <h3 class="text-xl font-bold mb-2"><%= venue.name %></h3>
              
              <div class="space-y-2 mb-4">
                <p class="text-sm text-gray-600">
                  <span class="inline-block mr-2">📍</span>
                  <%= venue.full_address %>
                </p>
                
                <% if venue.phone.present? %>
                  <p class="text-sm text-gray-600">
                    <span class="inline-block mr-2">📞</span>
                    <%= venue.phone %>
                  </p>
                <% end %>
                
                <p class="text-sm font-semibold text-blue-600">
                  <%= pluralize(venue.courts.active.count, 'court') %> available
                </p>
                
                <% if venue.courts.active.any? %>
                  <div class="flex flex-wrap gap-1 mt-2">
                    <% venue.courts.active.pluck(:court_type).uniq.each do |type| %>
                      <span class="text-xs px-2 py-1 bg-blue-100 text-blue-800 rounded">
                        <%= type.titleize %>
                      </span>
                    <% end %>
                    <% if venue.courts.active.where(has_air_conditioning: true).exists? %>
                      <span class="text-xs px-2 py-1 bg-green-100 text-green-800 rounded">
                        Air Conditioned
                      </span>
                    <% end %>
                  </div>
                <% end %>
              </div>

              <%= link_to "View Details & Book", venue_path(venue), 
                         class: "block w-full text-center bg-blue-600 text-white py-2 rounded hover:bg-blue-700" %>
            </div>
          </div>
        <% end %>
      </div>

      <div class="mt-8 flex justify-center">
        <%= paginate @venues %>
      </div>
    <% else %>
      <div class="bg-white rounded-lg shadow-md p-12 text-center">
        <p class="text-xl text-gray-600 mb-4">No venues found matching your criteria</p>
        <%= link_to "Clear Filters", venues_path, class: "text-blue-600 hover:text-blue-800" %>
      </div>
    <% end %>
  </div>
</div>
