<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full">
    <!-- Logo & Header -->
    <div class="text-center mb-8">
      <%= link_to main_root_path, class: "inline-flex items-center space-x-2 mb-6" do %>
        <span class="text-5xl">🏸</span>
        <span class="text-3xl font-bold text-blue-600">
          <%= current_account ? current_account.name : 'BadmintonPH' %>
        </span>
      <% end %>
      <h2 class="text-3xl font-bold text-gray-900 mb-2">Welcome Back</h2>
      <p class="text-gray-600">Sign in to your account to continue</p>
    </div>

    <!-- Sign In Card -->
    <div class="bg-white rounded-2xl shadow-xl p-8">
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>
        <!-- Email -->
        <div>
          <%= f.label :email, "Email Address", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.email_field :email, 
                           autofocus: true, 
                           autocomplete: "email",
                           class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-transparent transition",
                           placeholder: "you@example.com" %>
        </div>

        <!-- Password -->
        <div>
          <div class="flex justify-between items-center mb-2">
            <%= f.label :password, "Password", class: "block text-sm font-medium text-gray-700" %>
            <%= link_to "Forgot password?", new_password_path(resource_name), class: "text-sm text-blue-600 hover:text-blue-800" %>
          </div>
          <%= f.password_field :password, 
                              autocomplete: "current-password",
                              class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-transparent transition",
                              placeholder: "Enter your password" %>
        </div>

        <!-- Remember Me -->
        <% if devise_mapping.rememberable? %>
          <div class="flex items-center">
            <%= f.check_box :remember_me, class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" %>
            <%= f.label :remember_me, class: "ml-2 block text-sm text-gray-700" %>
          </div>
        <% end %>

        <!-- Submit Button -->
        <div>
          <%= f.submit "Sign In", class: "w-full bg-gradient-to-r from-blue-600 to-blue-700 text-white py-3 rounded-lg font-semibold hover:from-blue-700 hover:to-blue-800 transition shadow-lg cursor-pointer" %>
        </div>
      <% end %>

      <!-- Divider -->
      <div class="relative my-6">
        <div class="absolute inset-0 flex items-center">
          <div class="w-full border-t border-gray-300"></div>
        </div>
        <div class="relative flex justify-center text-sm">
          <span class="px-2 bg-white text-gray-500">Don't have an account?</span>
        </div>
      </div>

      <!-- Sign Up Link -->
      <div class="text-center">
        <%= link_to "Create an account", new_registration_path(resource_name), class: "text-blue-600 hover:text-blue-800 font-semibold" %>
      </div>
    </div>

    <!-- Additional Links -->
    <div class="mt-6 text-center text-sm text-gray-600">
      <%= link_to "← Back to Home", main_root_path, class: "hover:text-blue-600" %>
    </div>
  </div>
</div>
