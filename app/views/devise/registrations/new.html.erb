<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full">
    <!-- Logo & Header -->
    <div class="text-center mb-8">
      <%= link_to main_root_path, class: "inline-flex items-center space-x-2 mb-6" do %>
        <span class="text-5xl">🏸</span>
        <span class="text-3xl font-bold text-blue-600">
          <%= current_account ? current_account.name : 'BadmintonPH' %>
        </span>
      <% end %>
      <h2 class="text-3xl font-bold text-gray-900 mb-2">Create Account</h2>
      <p class="text-gray-600">Join us to start booking courts</p>
    </div>

    <!-- Sign Up Card -->
    <div class="bg-white rounded-2xl shadow-xl p-8">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-6" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <!-- Name Fields -->
        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= f.label :first_name, "First Name", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.text_field :first_name, 
                            autofocus: true,
                            class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-transparent transition",
                            placeholder: "John" %>
          </div>

          <div>
            <%= f.label :last_name, "Last Name", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.text_field :last_name,
                            class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-transparent transition",
                            placeholder: "Doe" %>
          </div>
        </div>

        <!-- Email -->
        <div>
          <%= f.label :email, "Email Address", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.email_field :email, 
                           autocomplete: "email",
                           class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-transparent transition",
                           placeholder: "you@example.com" %>
        </div>

        <!-- Phone -->
        <div>
          <%= f.label :phone, "Phone Number", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_field :phone,
                          class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-transparent transition",
                          placeholder: "+63 917 123 4567" %>
        </div>

        <!-- Password -->
        <div>
          <%= f.label :password, "Password", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <% if @minimum_password_length %>
            <span class="text-xs text-gray-500">(Minimum <%= @minimum_password_length %> characters)</span>
          <% end %>
          <%= f.password_field :password, 
                              autocomplete: "new-password",
                              class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-transparent transition",
                              placeholder: "Create a strong password" %>
        </div>

        <!-- Password Confirmation -->
        <div>
          <%= f.label :password_confirmation, "Confirm Password", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.password_field :password_confirmation, 
                              autocomplete: "new-password",
                              class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-transparent transition",
                              placeholder: "Re-enter your password" %>
        </div>

        <!-- Player Type (Optional) -->
        <div>
          <%= f.label :player_type, "Player Type (Optional)", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.select :player_type,
                      options_for_select([['Select type', ''], ['Singles', 'singles'], ['Doubles', 'doubles'], ['Both', 'both']], f.object.player_type),
                      {},
                      class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-transparent transition" %>
        </div>

        <!-- Skill Level (Optional) -->
        <div>
          <%= f.label :skill_level, "Skill Level (Optional)", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.select :skill_level,
                      options_for_select([['Select level', ''], ['Beginner', 'beginner'], ['Intermediate', 'intermediate'], ['Advanced', 'advanced'], ['Professional', 'professional']], f.object.skill_level),
                      {},
                      class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-transparent transition" %>
        </div>

        <!-- Terms & Conditions -->
        <div class="flex items-start">
          <input type="checkbox" required class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded mt-1">
          <label class="ml-2 block text-sm text-gray-700">
            I agree to the <%= link_to "Terms and Conditions", terms_path, class: "text-blue-600 hover:text-blue-800", target: "_blank" %> and 
            <%= link_to "Privacy Policy", privacy_path, class: "text-blue-600 hover:text-blue-800", target: "_blank" %>
          </label>
        </div>

        <!-- Submit Button -->
        <div>
          <%= f.submit "Create Account", class: "w-full bg-gradient-to-r from-blue-600 to-blue-700 text-white py-3 rounded-lg font-semibold hover:from-blue-700 hover:to-blue-800 transition shadow-lg cursor-pointer" %>
        </div>
      <% end %>

      <!-- Divider -->
      <div class="relative my-6">
        <div class="absolute inset-0 flex items-center">
          <div class="w-full border-t border-gray-300"></div>
        </div>
        <div class="relative flex justify-center text-sm">
          <span class="px-2 bg-white text-gray-500">Already have an account?</span>
        </div>
      </div>

      <!-- Sign In Link -->
      <div class="text-center">
        <%= link_to "Sign in instead", new_session_path(resource_name), class: "text-blue-600 hover:text-blue-800 font-semibold" %>
      </div>
    </div>

    <!-- Additional Links -->
    <div class="mt-6 text-center text-sm text-gray-600">
      <%= link_to "← Back to Home", main_root_path, class: "hover:text-blue-600" %>
    </div>
  </div>
</div>