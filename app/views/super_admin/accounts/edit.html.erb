<div class="max-w-2xl mx-auto">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Edit Account</h1>
    <p class="text-gray-600 mt-1">Update account information</p>
  </div>

  <div class="bg-white rounded-xl shadow-lg p-8">
    <%= form_with model: @account, url: super_admin_account_path(@account), method: :patch, class: "space-y-6" do |f| %>
      <!-- Same form fields as new.html.erb -->
      <!-- (Copy the entire form from new.html.erb) -->
      
      <!-- Account Name -->
      <div>
        <%= f.label :name, "Account Name", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_field :name, 
                        class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-600 focus:border-transparent",
                        placeholder: "e.g., Makati Sports Complex" %>
      </div>

      <!-- Subdomain -->
      <div>
        <%= f.label :subdomain, "Subdomain", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <div class="flex">
          <%= f.text_field :subdomain, 
                          class: "flex-1 px-4 py-3 border border-gray-300 rounded-l-lg focus:ring-2 focus:ring-purple-600 focus:border-transparent",
                          placeholder: "makati" %>
          <span class="inline-flex items-center px-4 py-3 bg-gray-100 border border-l-0 border-gray-300 rounded-r-lg text-gray-600">
            .badminton.ph
          </span>
        </div>
      </div>

      <!-- Owner Information -->
      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :owner_name, "Owner Name", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_field :owner_name, 
                          class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-600 focus:border-transparent" %>
        </div>

        <div>
          <%= f.label :owner_email, "Owner Email", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.email_field :owner_email, 
                           class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-600 focus:border-transparent" %>
        </div>
      </div>

      <!-- Phone -->
      <div>
        <%= f.label :phone, "Phone Number", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_field :phone, 
                        class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-600 focus:border-transparent" %>
      </div>

      <!-- Address -->
      <div>
        <%= f.label :address, "Street Address", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_field :address, 
                        class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-600 focus:border-transparent" %>
      </div>

      <!-- Location -->
      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :city, "City", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_field :city, 
                          class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-600 focus:border-transparent" %>
        </div>

        <div>
          <%= f.label :province, "Province", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.select :province,
                      options_for_select(Venue::PROVINCES, @account.province),
                      { include_blank: 'Select province' },
                      class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-600 focus:border-transparent" %>
        </div>
      </div>

      <!-- Plan -->
      <div>
        <%= f.label :plan, "Subscription Plan", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.select :plan,
                    options_for_select([['Basic', 'basic'], ['Premium', 'premium'], ['Enterprise', 'enterprise']], @account.plan),
                    {},
                    class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-600 focus:border-transparent" %>
      </div>

      <!-- Active Status -->
      <div class="flex items-center">
        <%= f.check_box :active, class: "h-4 w-4 text-purple-600 focus:ring-purple-500 border-gray-300 rounded" %>
        <%= f.label :active, "Active (account can be accessed)", class: "ml-2 text-sm text-gray-700" %>
      </div>

      <!-- Actions -->
      <div class="flex space-x-3 pt-4">
        <%= link_to "Cancel", super_admin_account_path(@account), class: "flex-1 bg-gray-200 text-gray-700 py-3 rounded-lg hover:bg-gray-300 transition font-semibold text-center" %>
        <%= f.submit "Update Account", class: "flex-1 bg-purple-600 text-white py-3 rounded-lg hover:bg-purple-700 transition font-semibold cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
