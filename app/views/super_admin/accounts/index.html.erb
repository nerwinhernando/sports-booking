<div class="mb-8">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Accounts</h1>
      <p class="text-gray-600 mt-1">Manage all venue accounts</p>
    </div>
    <%= link_to new_super_admin_account_path, class: "bg-purple-600 text-white px-6 py-3 rounded-lg hover:bg-purple-700 transition font-semibold" do %>
      + New Account
    <% end %>
  </div>
</div>

<!-- Stats Cards -->
<div class="grid md:grid-cols-4 gap-6 mb-8">
  <div class="bg-white rounded-xl shadow-md p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-gray-600 text-sm">Total Accounts</p>
        <p class="text-3xl font-bold text-gray-900 mt-1"><%= @accounts.count %></p>
      </div>
      <div class="text-4xl">🏢</div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-md p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-gray-600 text-sm">Active</p>
        <p class="text-3xl font-bold text-green-600 mt-1"><%= @accounts.where(active: true).count %></p>
      </div>
      <div class="text-4xl">✅</div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-md p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-gray-600 text-sm">Inactive</p>
        <p class="text-3xl font-bold text-red-600 mt-1"><%= @accounts.where(active: false).count %></p>
      </div>
      <div class="text-4xl">❌</div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-md p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-gray-600 text-sm">Total Venues</p>
        <p class="text-3xl font-bold text-blue-600 mt-1"><%= Venue.count %></p>
      </div>
      <div class="text-4xl">🏸</div>
    </div>
  </div>
</div>

<!-- Accounts Table -->
<div class="bg-white rounded-xl shadow-lg overflow-hidden">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Account</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Subdomain</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Owner</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Location</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Plan</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Venues</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @accounts.each do |account| %>
          <tr class="hover:bg-gray-50 transition">
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center">
                <div class="text-sm font-medium text-gray-900"><%= account.name %></div>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center">
                <code class="text-sm bg-gray-100 px-2 py-1 rounded"><%= account.subdomain %></code>
                <a href="http://<%= account.subdomain %>.lvh.me:3000" target="_blank" class="ml-2 text-blue-600 hover:text-blue-800">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                  </svg>
                </a>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm text-gray-900"><%= account.owner_name %></div>
              <div class="text-sm text-gray-500"><%= account.owner_email %></div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm text-gray-900"><%= account.city %></div>
              <div class="text-sm text-gray-500"><%= account.province %></div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="px-3 py-1 text-xs font-semibold rounded-full <%= account.plan == 'enterprise' ? 'bg-purple-100 text-purple-800' : account.plan == 'premium' ? 'bg-blue-100 text-blue-800' : 'bg-gray-100 text-gray-800' %>">
                <%= account.plan&.titleize || 'Basic' %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <% if account.active? %>
                <span class="px-3 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">Active</span>
              <% else %>
                <span class="px-3 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">Inactive</span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
              <%= account.venues.count %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <div class="flex items-center justify-end space-x-2">
                <%= link_to super_admin_account_path(account), class: "text-blue-600 hover:text-blue-800" do %>
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                  </svg>
                <% end %>

                <%= link_to edit_super_admin_account_path(account), class: "text-yellow-600 hover:text-yellow-800" do %>
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                  </svg>
                <% end %>

                <% if account.active? %>
                  <%= button_to deactivate_super_admin_account_path(account), method: :patch, class: "text-red-600 hover:text-red-800", data: { confirm: 'Are you sure?' } do %>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path>
                    </svg>
                  <% end %>
                <% else %>
                  <%= button_to activate_super_admin_account_path(account), method: :patch, class: "text-green-600 hover:text-green-800" do %>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  <% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<% if @accounts.empty? %>
  <div class="text-center py-12">
    <div class="text-6xl mb-4">🏢</div>
    <h3 class="text-xl font-bold text-gray-900 mb-2">No accounts yet</h3>
    <p class="text-gray-600 mb-6">Create your first account to get started</p>
    <%= link_to "Create Account", new_super_admin_account_path, class: "inline-block bg-purple-600 text-white px-6 py-3 rounded-lg hover:bg-purple-700 transition font-semibold" %>
  </div>
<% end %>
